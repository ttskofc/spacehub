# Базовый URL веб-сервера 1С (без trailing slash)
ONEC_BASE_URL=http://localhost:8080/spacehub/hs/api/v1

# Таймаут запросов к 1С, секунды
ONEC_TIMEOUT=10

# Разрешённые источники CORS, через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Заглушка рабочего дня для мини-таймлайна карточки (1С занятость не отдаёт)
WORK_DAY_START=09:00
WORK_DAY_END=19:00
